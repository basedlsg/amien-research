# AMIEN Research - Environment Configuration Template
# Copy this file to .env and fill in your actual values

# ============================================
# AI Provider API Keys
# ============================================

# Google Gemini API Key
# Get from: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your_google_gemini_api_key_here

# OpenAI API Key
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude API Key
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ============================================
# Database Configuration
# ============================================

# SQLite Database Path
DATABASE_PATH=cloudvr_perfguard.db

# Database Connection Pool Size
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ============================================
# API Server Configuration
# ============================================

# API Server Host (0.0.0.0 for all interfaces, 127.0.0.1 for localhost only)
API_HOST=0.0.0.0

# API Server Port
API_PORT=8000

# API Workers (for production deployment)
API_WORKERS=4

# API Reload (set to true for development)
API_RELOAD=false

# ============================================
# CloudVR Performance Monitoring
# ============================================

# VR Performance Collection Interval (seconds)
VR_COLLECTION_INTERVAL=1.0

# VR Performance Metrics Retention (days)
VR_METRICS_RETENTION_DAYS=30

# Comfort Score Threshold (0.0-1.0)
VR_COMFORT_THRESHOLD=0.7

# Target FPS
VR_TARGET_FPS=72

# Max Acceptable Latency (ms)
VR_MAX_LATENCY_MS=20

# ============================================
# AI Function Discovery (FunSearch)
# ============================================

# FunSearch Evolution Iterations
FUNSEARCH_MAX_ITERATIONS=100

# FunSearch Population Size
FUNSEARCH_POPULATION_SIZE=50

# FunSearch Mutation Rate (0.0-1.0)
FUNSEARCH_MUTATION_RATE=0.1

# FunSearch Timeout (seconds)
FUNSEARCH_TIMEOUT=600

# AI Model for Function Discovery
FUNSEARCH_MODEL=gemini-pro

# ============================================
# AI Research Automation
# ============================================

# Research Paper Generation Model
RESEARCH_MODEL=gemini-pro

# Research Output Directory
RESEARCH_OUTPUT_DIR=research_outputs

# Auto-generate Papers (true/false)
AUTO_GENERATE_PAPERS=false

# Paper Generation Interval (hours)
PAPER_GENERATION_INTERVAL=24

# ============================================
# Docker Configuration
# ============================================

# Docker Registry (for CloudVR monitoring)
DOCKER_REGISTRY=docker.io

# Docker Image Tag
DOCKER_IMAGE_TAG=latest

# ============================================
# Logging Configuration
# ============================================

# Log Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Log Format (json, text)
LOG_FORMAT=json

# Log File Path (leave empty to disable file logging)
LOG_FILE=logs/amien-research.log

# ============================================
# Security (IMPORTANT: Set for production!)
# ============================================

# API Authentication Enabled (true/false)
# WARNING: Currently not implemented - set to false
API_AUTH_ENABLED=false

# API Key (when authentication is implemented)
API_KEY=your_secure_api_key_here

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Rate Limiting (requests per minute)
RATE_LIMIT_RPM=100

# ============================================
# Feature Flags
# ============================================

# Enable Function Execution (WARNING: Security risk with exec())
# Set to false to disable exec() evaluation
ENABLE_FUNCTION_EXECUTION=false

# Enable Experimental Features
ENABLE_EXPERIMENTAL=false

# ============================================
# Performance Tuning
# ============================================

# Max Concurrent AI Requests
MAX_CONCURRENT_AI_REQUESTS=5

# AI Request Timeout (seconds)
AI_REQUEST_TIMEOUT=30

# Cache TTL (seconds)
CACHE_TTL=3600

# ============================================
# Monitoring & Observability (Optional)
# ============================================

# Weights & Biases API Key (for experiment tracking)
WANDB_API_KEY=your_wandb_key_here

# W&B Project Name
WANDB_PROJECT=amien-research

# Sentry DSN (for error tracking)
SENTRY_DSN=your_sentry_dsn_here

# ============================================
# Development Settings
# ============================================

# Development Mode (enables debug features)
DEV_MODE=true

# Debug SQL Queries
DEBUG_SQL=false

# Profiling Enabled
PROFILING_ENABLED=false
